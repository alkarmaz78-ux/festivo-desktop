{
  "name": "festivo-desktop",
  "version": "1.0.2",
  "description": "FESTIVO desktop app with separate host and guest display windows",
  "main": "main.js",
  "author": "FESTIVO",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "node -e \"require('png-to-ico')('build/icon.png').then(buf=>require('fs').writeFileSync('build/icon.ico',buf)).catch(err=>{console.error(err);process.exit(1)})\" && electron-builder --win nsis --publish never",
    "release": "node -e \"require('png-to-ico')('build/icon.png').then(buf=>require('fs').writeFileSync('build/icon.ico',buf)).catch(err=>{console.error(err);process.exit(1)})\" && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.festivo.desktop",
    "productName": "FESTIVO",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "FESTIVO-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alkarmaz78-ux",
        "repo": "festivo-desktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
